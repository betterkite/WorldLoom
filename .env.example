# =================================================================
# WorldLoom 环境文件职责
# =================================================================
# 文件优先级（Next.js 自动加载顺序，后者覆盖前者）：
#   1. .env.example —— 本文件：入库文档，只写说明不写真实值
#   2. .env.local   —— 被忽略：凭据与本机覆盖（LLM API Key 只放这里）
#   3. .env         —— 被忽略：本地基础设施默认值（DATABASE_URL 等，Prisma CLI 读取）
#
# 不要把真实密钥写进本文件或提交到任何被追踪的文件。
# 泄露的客户端 Key 可在网关侧单独吊销，无需轮换上游账号。

# --- .env（基础设施默认值，非密钥）---
DATABASE_URL=postgresql://worldloom:worldloom@localhost:43133/worldloom
TEST_DATABASE_URL=postgresql://worldloom:worldloom@localhost:43133/worldloom_test
# Docker compose uses the internal `db` hostname by default. Set this only when
# the container needs a custom/escaped connection URL; do not reuse the host URL above.
# WORLDLOOM_CONTAINER_DATABASE_URL=postgresql://worldloom:worldloom@db:5432/worldloom

# --- .env.local（凭据；变量名与 config/llm.json 的 credentialEnv 一一对应）---
DEEPSEEK_API_KEY=       # deepseek-official profile
MODELPORT_API_KEY=      # modelport profile（本机 ModelPort 网关，可选）
EMBEDDINGS_API_KEY=     # 可选；远程 Embedding 优先路径；不可用时回退本地模型，不显示 provider 余额

# --- 应用 ---
NEXT_PUBLIC_APP_URL=
BUILD_STANDALONE=       # Docker/自托管 standalone 构建时设为 true
WORLDLOOM_WORKER=false  # 受控生产 worker 实例设为 true；普通 Web 实例保持 false
WORLDLOOM_TLS_TERMINATED=false # 仅在可信 TLS 反向代理前设为 true，以启用 HSTS

# --- 严格发布门禁：仅在对应部署事实已经完成并留有记录后设为 true ---
# WORLDLOOM_GATEWAY_AUTH_CONFIRMED=false
# WORLDLOOM_RATE_LIMIT_CONFIRMED=false
# WORLDLOOM_BACKUP_RESTORE_CONFIRMED=false
# WORLDLOOM_MIGRATION_ROLLBACK_CONFIRMED=false
# WORLDLOOM_TARGET_SCALE_CONFIRMED=false
# WORLDLOOM_WORKER_TOPOLOGY_CONFIRMED=false
