# =================================================================
# WorldLoom 环境文件职责
# =================================================================
# 文件优先级（Next.js 自动加载顺序，后者覆盖前者）：
#   1. .env.example —— 本文件：入库文档，只写说明不写真实值
#   2. .env.local   —— 被忽略：凭据与本机覆盖（LLM API Key 只放这里）
#   3. .env         —— 被忽略：本地基础设施默认值（DATABASE_URL 等，Prisma CLI 读取）
#
# 不要把真实密钥写进本文件或提交到任何被追踪的文件。
# 泄露的客户端 Key 可在网关侧单独吊销，无需轮换上游账号。

# --- .env（基础设施默认值，非密钥）---
DATABASE_URL=postgresql://worldloom:worldloom@localhost:43133/worldloom
TEST_DATABASE_URL=postgresql://worldloom:worldloom@localhost:43133/worldloom_test
# Docker compose uses the internal `db` hostname by default. Set this only when
# the container needs a custom/escaped connection URL; do not reuse the host URL above.
# WORLDLOOM_CONTAINER_DATABASE_URL=postgresql://worldloom:worldloom@db:5432/worldloom

# --- .env.local（凭据；变量名与 config/llm.json 的 credentialEnv 一一对应）---
# deepseek-official profile
DEEPSEEK_API_KEY=
# modelport profile（本机 ModelPort 网关，可选）
MODELPORT_API_KEY=
# 可选；远程 Embedding 优先路径；不可用时回退本地模型，不显示 provider 余额
EMBEDDINGS_API_KEY=

# --- 应用 ---
NEXT_PUBLIC_APP_URL=http://127.0.0.1:4310
# Docker/自托管 standalone 构建时设为 true
BUILD_STANDALONE=
# 受控生产 worker 实例设为 true；普通 Web 实例保持 false
WORLDLOOM_WORKER=false
# worker 进程内 CompileRun/semantic job 总并发上限
WORLDLOOM_WORKER_MAX_CONCURRENCY=4
# 仅在可信 TLS 反向代理前设为 true，以启用 HSTS
WORLDLOOM_TLS_TERMINATED=false

# --- 默认 LLM profile 的每次业务操作预算（必须来自批准的账户/合同，不要猜测）---
# 本机单人首发选择不设预算额度：保持以下参数不设置，不自动填写默认上限。
# 累计用量统计应独立于预算拦截；单次输出能力/分章和进程资源保护仍需保留。
# 覆盖 CompileRun 与问答、创世、推演、答案评测的累计应用侧软阈值；不是账户级硬限额。
# 不启用覆盖时保持注释/不设置；显式空值或非法值会阻断模型请求，不能当作取消预算。
# token 上限须为正的安全整数，费用上限须为正的有限数值。
# WORLDLOOM_LLM_MAX_INPUT_TOKENS_PER_RUN=
# WORLDLOOM_LLM_MAX_OUTPUT_TOKENS_PER_RUN=
# WORLDLOOM_LLM_MAX_ESTIMATED_COST_USD_PER_RUN=

# --- 可选本机累计 CNY 预算；同时配置两项才有完整配置，不是 provider 账户硬额度 ---
# 仅填写自己批准的额度；不要把一次测试的 5 元授权作为永久默认值。
# 账本必须使用可写、可持久化的绝对路径；app/worker 共享预算时共享同一账本。
# WORLDLOOM_LLM_BUDGET_CNY=
# WORLDLOOM_LLM_BUDGET_LEDGER=

# --- 严格发布门禁：仅在对应部署事实已经完成并留有记录后设为 true ---
# WORLDLOOM_GATEWAY_AUTH_CONFIRMED=false
# WORLDLOOM_RATE_LIMIT_CONFIRMED=false
# WORLDLOOM_BACKUP_RESTORE_CONFIRMED=false
# WORLDLOOM_MIGRATION_ROLLBACK_CONFIRMED=false
# WORLDLOOM_TARGET_SCALE_CONFIRMED=false
# WORLDLOOM_WORKER_TOPOLOGY_CONFIRMED=false
# WORLDLOOM_SUPPLY_CHAIN_CONFIRMED=false # SBOM, provenance, digest and vulnerability review
# WORLDLOOM_OBSERVABILITY_CONFIRMED=false # metrics, alerting, runbook and incident drill
# WORLDLOOM_PRIVACY_CONFIRMED=false # data classification, retention, deletion and access review

# --- 本机单人首发的额外证据登记；不要为通过预检而直接全部设 true ---
# 只在对应版本/配置的真实记录已完成后，在执行本机预检的进程中声明。
# 公网 strict 仍保留；本机使用也需要恢复、迁移、许可和隐私等既有证据。
# WORLDLOOM_LOCAL_NETWORK_CONFIRMED=false
# WORLDLOOM_LOCAL_INSTALL_CONFIRMED=false
# WORLDLOOM_LOCAL_USAGE_CONFIRMED=false
# WORLDLOOM_LOCAL_RESOURCE_BASELINE_CONFIRMED=false
