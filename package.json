{
  "name": "worldloom",
  "version": "1.0.0",
  "private": false,
  "description": "Worldbuilding & chronicle studio — LLM-compiled, versioned, self-consistent worlds",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/betterkite/WorldLoom.git"
  },
  "scripts": {
    "acceptance": "node scripts/acceptance.mjs",
    "audit": "node scripts/audit.mjs",
    "benchmark:retrieval": "node scripts/benchmark-retrieval.mjs",
    "build": "next build",
    "db:backup:drill": "node scripts/db-backup-restore-drill.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "embeddings:download": "node scripts/download-local-embedding.mjs",
    "deployment:preflight": "node scripts/deployment-preflight.mjs",
    "dev": "next dev -p 4310",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format": "oxfmt --write . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "format:check": "oxfmt --check . '!**/*.md' '!**/*.mdc' '!**/*.mdx' '!**/*.yml' '!**/*.yaml'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix && bun format",
    "lint:strict": "oxlint --deny-warnings",
    "license:audit": "node scripts/license-audit.mjs",
    "prepare": "husky",
    "start": "next start -p 4310",
    "start:worker": "WORLDLOOM_WORKER=true next start -p 4310",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "worker:smoke": "node scripts/worker-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@huggingface/transformers": "^4.3.0",
    "@prisma/client": "^6.19.3",
    "@shadcn/react": "^0.2.1",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.5.0",
    "kbar": "0.1.0-beta.48",
    "match-sorter": "^8.3.0",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nuqs": "^2.10.1",
    "postcss": "8.5.25",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.4.1",
    "reagraph": "^4.32.0",
    "sharp": "^0.35.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.7.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "22.10.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sort-by": "^1.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.82.0",
    "prisma": "^6.19.3",
    "tw-animate-css": "^1.4.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "!(scripts)/**/*.{js,jsx,tsx,ts,css,less,scss,sass}": [
      "oxfmt --write"
    ]
  }
}
